# Copy to .env.local (not committed) to run the app against Supabase locally.
# Without these two lines the app runs in local demo mode.

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (safe to expose; access is controlled by RLS)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Only needed for phones (native apps): where the api/ functions live, e.g. https://alfk-app.vercel.app
# EXPO_PUBLIC_API_URL=

# ——— Server only (Vercel → Settings → Environment Variables). NEVER prefix with EXPO_PUBLIC_. ———
# Supabase → Project Settings → API Keys → Secret key
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Emails (Brevo) — api/email.ts. Brevo → SMTP & API → API keys.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# Sender verified in Brevo → Senders, domains & dedicated IPs → Senders
# BREVO_SENDER_EMAIL=amicalelyceefrancaisdekoweit@gmail.com
# BREVO_SENDER_NAME=Amicale LFK
# Optional: ids of the Brevo lists for members who accept the news (Brevo → Contacts → Lists)
# BREVO_LIST_ALUMNI=2
# BREVO_LIST_ELEVES=3
# Optional: address used in the emails' links (default https://www.alfk.org)
# SITE_URL=https://www.alfk.org
